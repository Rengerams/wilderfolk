{
  "compilerOptions": {
    "target": "ES2023",
    /* `DOM` is here for the Node/Tauri worker entry below, not for the config files: importing
       `gameWorker.ts` pulls in the simulation modules, which type against `CanvasRenderingContext2D`
       and friends. That is the point of including it — the entry is checked against the same modules
       the browser worker compiles, so a drift in those types surfaces here. */
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* Incremental build state is a cache, not a source file: keep it out of the
       repository root and inside the ignored, project-local cache directory. */
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    /* The Node/Tauri `worker_threads` entry. `tsconfig.app.json` excludes it (it imports `node:*`),
       and until now no other project claimed it, so `npm run build` never type-checked the file that
       the Node harness and the Tauri build actually run (`docs/private/audits/2026-09-20` — bug 73 /
       OPEN-13). Measured before adding it: 0 errors under these options, so the gate arrives green
       rather than being widened to accommodate a red file. `scripts/**` remains outside every project
       and still carries the four deliberate errors that register records. */
    "src/game/simWorker/gameWorker.node.ts"
  ]
}