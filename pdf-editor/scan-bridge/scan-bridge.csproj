<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfStudio.ScanBridge</RootNamespace>
    <AssemblyName>pdf-studio-scan-bridge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAPS2 drives WIA/TWAIN scanners and can also export OCR'd PDFs. -->
    <PackageReference Include="NAPS2.Sdk" Version="7.*" />
  </ItemGroup>

</Project>
