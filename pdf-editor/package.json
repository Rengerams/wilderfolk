{
  "name": "wilderfolk-pdf-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "PDF Studio — PDF editing without unnecessary complexity. Independent of the Wilderfolk game app.",
  "scripts": {
    "predev": "node scripts/prepare-ocr-assets.mjs",
    "dev": "vite",
    "desktop": "tauri dev",
    "installer": "tauri build",
    "prebuild": "node scripts/prepare-ocr-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
