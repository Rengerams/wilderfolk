{
  "name": "wilderfolk-pdf-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PDF Studio — PDF editing without unnecessary complexity. Independent of the Wilderfolk game app.",
  "scripts": {
    "dev": "vite",
    "desktop": "npx --yes @tauri-apps/cli@^2 dev",
    "installer": "npx --yes @tauri-apps/cli@^2 build",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
