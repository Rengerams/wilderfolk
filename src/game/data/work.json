    {
      "id": "wf_work_midnight_shift",
      "category": "work",
      "speakers": [
        "npc_clockmaker",
        "npc_night_guard"
      ],
      "lines": [
        {
          "speaker": "npc_clockmaker",
          "text": "The clock tower struck thirteen. I think it is asking for overtime."
        },
        {
          "speaker": "npc_night_guard",
          "text": "It has been asking for overtime since I started talking to it."
        },
        {
          "speaker": "npc_clockmaker",
          "text": "You talk to the clock?"
        },
        {
          "speaker": "npc_night_guard",
          "text": "Only on nights when it lies about the hour."
        },
        {
          "speaker": "npc_clockmaker",
          "text": "Then we agree the machinery is malfunctioning."
        },
        {
          "speaker": "npc_night_guard",
          "text": "No. We agree it knows exactly what it is doing."
        }
      ]
    },
    {
      "id": "wf_funny_work_fence",
      "category": "work",
      "speakers": [
        "fencer",
        "carpenter"
      ],
      "lines": [
        {
          "speaker": "fencer",
          "text": "I repaired this fence twice today."
        },
        {
          "speaker": "carpenter",
          "text": "Was it broken twice?"
        },
        {
          "speaker": "fencer",
          "text": "No. It moved while I was looking for my hammer."
        }
      ]
    }
