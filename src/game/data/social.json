    {
      "id": "wf_relationship_pressure",
      "category": "social",
      "speakers": [
        "npc_invested",
        "npc_cynical"
      ],
      "lines": [
        {
          "speaker": "npc_invested",
          "text": "You keep saying you don't care, but you repaired my roof before the storm."
        },
        {
          "speaker": "npc_cynical",
          "text": "I repaired the roof because replacing you would have taken longer."
        },
        {
          "speaker": "npc_invested",
          "text": "Then why did you leave your coat on my chair?"
        },
        {
          "speaker": "npc_cynical",
          "text": "Because you were shivering. Don't turn a practical decision into a confession."
        },
        {
          "speaker": "npc_invested",
          "text": "I won't. But tomorrow, if you disappear, I'm coming after you."
        },
        {
          "speaker": "npc_cynical",
          "text": "That's the problem. I know you mean it."
        }
      ]
    },
    {
      "id": "wf_secret_conflict",
      "category": "social",
      "speakers": [
        "npc_invested",
        "npc_cynical"
      ],
      "lines": [
        {
          "speaker": "npc_invested",
          "text": "The council's missing ledger was in your room. Tell me you didn't take it."
        },
        {
          "speaker": "npc_cynical",
          "text": "I didn't take it from the council."
        },
        {
          "speaker": "npc_invested",
          "text": "That is a very careful answer. Where did you get it?"
        },
        {
          "speaker": "npc_cynical",
          "text": "You don't want the truth. You want a version that lets you keep defending me."
        },
        {
          "speaker": "npc_invested",
          "text": "I want to know whether the guards are looking for the wrong person."
        },
        {
          "speaker": "npc_cynical",
          "text": "They are."
        },
        {
          "speaker": "npc_invested",
          "text": "And you know who they should be looking for?"
        },
        {
          "speaker": "npc_cynical",
          "text": "I know who will be hurt if they find out. That is not the same thing."
        },
        {
          "speaker": "npc_invested",
          "text": "You promised me you wouldn't make me choose between the settlement and you."
        },
        {
          "speaker": "npc_cynical",
          "text": "I promised you nothing. You heard what you needed to hear."
        }
      ]
    },
    {
      "id": "wf_social_rumor",
      "category": "social",
      "speakers": [
        "npc_gossip",
        "npc_recluse"
      ],
      "lines": [
        {
          "speaker": "npc_gossip",
          "text": "People say you have been meeting someone behind the old mill."
        },
        {
          "speaker": "npc_recluse",
          "text": "People say many things because silence makes them nervous."
        },
        {
          "speaker": "npc_gossip",
          "text": "So you deny it?"
        },
        {
          "speaker": "npc_recluse",
          "text": "I deny that the old mill is behind anything. It is clearly beside the river."
        },
        {
          "speaker": "npc_gossip",
          "text": "That is not the denial I asked for."
        },
        {
          "speaker": "npc_recluse",
          "text": "Then ask a question you are prepared to hear answered."
        }
      ]
    },
    {
      "id": "wf_funny_social_crow",
      "category": "social",
      "speakers": [
