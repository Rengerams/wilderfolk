{
  "name": "wilderfolk",
  "private": true,
  "version": "0.6.4",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:source": "node scripts/check-source-shadow-files.mjs",
    "test": "npm run test:standard",
    "test:standard": "npm run check:source && vitest run --exclude tests/fullYear.integration.test.ts",
    "test:all": "npm run test:standard && npm run test:types && npm run lint && audit:knip",
    "test:full-year:test": "vitest run tests/fullYear.integration.test.ts",
    "test:full": "npm run test:all && npm run test:full-year",
    "test:types": "tsc -p tsconfig.vitest.json --noEmit",
    "graph": "node scripts/graph.mjs",
    "test:watch": "vitest",
    "test:full-year": "tsx scripts/run-full-year.mts",
    "lint": "oxlint --type-aware --type-check src scripts vite.config.ts vitest.config.ts",
    "lint:fix": "oxlint --type-aware --type-check --fix src scripts vite.config.ts vitest.config.ts",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:dev:log": "node scripts/run-tauri-dev-log.mjs",
    "tauri:build": "tauri build",
    "dup": "jscpd src --min-lines 12 --min-tokens 60 --format typescript,tsx,javascript --ignore \"**/test/**,**/*.test.ts,**/data/**\"",
    "audit:knip": "knip --config knip.json --dependencies",
    "audit:dep": "dpdm --no-warning --no-tree src/main.tsx",
    "audit": "npm run audit:knip && npm run audit:dep"
  },
  "dependencies": {
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "dpdm": "^4.3.0",
    "jscpd": "^5.1.1",
    "knip": "^6.34.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
