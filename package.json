{
  "name": "wilderfolk",
  "private": true,
  "version": "0.6.5.1",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && node scripts/test.mjs lint && node scripts/test.mjs dup && tsc -p tsconfig.node.json --noEmit && vite build",
    "check:source": "node scripts/test.mjs check",
    "test": "node scripts/test.mjs",
    "test:standard": "node scripts/test.mjs standard",
    "test:all": "node scripts/test.mjs all",
    "test:full-year:test": "node scripts/test.mjs invariant-test",
    "test:full": "node scripts/test.mjs full",
    "test:types": "node scripts/test.mjs types",
    "test:watch": "node scripts/test.mjs watch",
    "test:full-year": "node scripts/test.mjs invariants",
    "test:browser": "node scripts/test.mjs browser",
    "test:accept": "node scripts/test.mjs accept",
    "lint": "node scripts/test.mjs lint",
    "lint:fix": "node scripts/test.mjs lint --fix",
    "preview": "vite preview",
    "tauri:dev": "npx tauri dev",
    "tauri:dev:log": "node scripts/run-tauri-dev-log.mjs",
    "tauri:build": "npx tauri build",
    "dup": "node scripts/test.mjs dup",
    "clean": "node scripts/test.mjs clean",
    "clean:apply": "node scripts/test.mjs clean --apply",
    "audit:knip": "node scripts/test.mjs knip",
    "audit:deps": "node scripts/test.mjs cycles",
    "audit:deps:cycles": "node scripts/test.mjs cycles",
    "audit:deps:cycles:strict": "node scripts/test.mjs cycles --strict",
    "audit:deps:graph": "node scripts/test.mjs cycles --json",
    "graph:calls": "node scripts/build-call-graph.mjs",
    "audit": "node scripts/test.mjs audit",
    "deno:build": "npm run build && deno desktop --backend webview --exclude node_modules .",
    "deno:test": "deno run --allow-read --allow-write --allow-env --allow-sys --allow-run scripts/test.mjs",
    "deno:dev": "deno desktop --hmr --backend webview .",
    "deno:build:cef": "npm run build && deno desktop --backend cef --exclude node_modules --output ./deno/wilderfolk-cef .",
    "perf:compare-runtimes": "node scripts/compare-runtimes.mjs",
    "tauri:windows:build": "tauri-windows-bundle build"
  },
  "packageManager": "",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "jscpd": "^5.4.2",
    "knip": "^6.42.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"

  },
  "allowScripts": {
    "esbuild": true,
    "skia-canvas@3.0.8": true,
    "@swc/core@1.16.18": true,
    "optipng-bin@7.0.1": true,
    "pngquant-bin@6.0.1": true,
    "sharp@0.27.0": true,
    "zopflipng-bin@6.0.1": true
  }
}
