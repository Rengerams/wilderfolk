{
  "name": "wilderfolk",
  "private": true,
  "version": "0.6.4",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:source": "node scripts/check-source-shadow-files.mjs",
    "test": "npm run test:standard",
    "test:standard": "npm run check:source && vitest run --exclude tests/fullYear.integration.test.ts",
    "test:all": "npm run test:standard && npm run test:types && npm run lint",
    "test:full-year:test": "vitest run tests/fullYear.integration.test.ts",
    "test:full": "npm run test:all && npm run test:full-year",
    "test:types": "tsc -p tsconfig.vitest.json --noEmit",
    "graph": "node scripts/graph.mjs",
    "test:watch": "vitest",
    "test:full-year": "tsx scripts/run-full-year.mts",
    "lint": "oxlint --type-aware --type-check src scripts vite.config.ts vitest.config.ts",
    "lint:fix": "oxlint --type-aware --type-check --fix src scripts vite.config.ts vitest.config.ts",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:dev:log": "node scripts/run-tauri-dev-log.mjs",
    "tauri:build": "tauri build",
    "dup": "jscpd src --min-lines 12 --min-tokens 60 --format typescript,tsx,javascript --ignore \"**/test/**,**/*.test.ts,**/data/**\"",
    "audit:knip": "knip",
    "audit:deps": "depcruise src --config .dependency-cruiser.cjs --ts-config tsconfig.app.json",
    "audit:deps:cycles": "depcruise src --config .dependency-cruiser.cjs --ts-config tsconfig.app.json --output-type err-long --focus \"circular\"",
    "audit:deps:graph": "depcruise src --config .dependency-cruiser.cjs --ts-config tsconfig.app.json --output-type dot > dependency-graph.dot",
    "audit": "npm run audit:knip && npm run audit:deps"
  },
  "dependencies": {
    "npm": "^12.0.2",
    "npm-install-checks": "^9.0.0",
    "pixi.js": "^8.20.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.23",
    "dependency-cruiser": "^18.1.1",
    "globals": "^17.11.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
