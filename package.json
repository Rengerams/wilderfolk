{
  "name": "wilderfolk",
  "private": true,
  "version": "0.6.2.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:source": "node scripts/check-source-shadow-files.mjs",
    "test": "npm run check:source && vitest run",
    "test:all": "npm run check:source && vitest run && tsc -p tsconfig.vitest.json --noEmit && oxlint --type-aware --type-check",
    "test:types": "tsc -p tsconfig.vitest.json --noEmit",
    "graph": "node scripts/graph.mjs",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "preview": "vite preview",
    "dup": "jscpd src --min-lines 12 --min-tokens 60 --format typescript,tsx,javascript --ignore \"**/test/**,**/*.test.ts,**/data/**\"",
    "audit:knip": "knip",
    "audit:deps": "depcruise src --config .dependency-cruiser.cjs --ts-config tsconfig.app.json",
    "audit:deps:cycles": "depcruise src --config .dependency-cruiser.cjs --ts-config tsconfig.app.json --output-type err-long --focus \"circular\"",
    "audit:deps:graph": "depcruise src --config .dependency-cruiser.cjs --ts-config tsconfig.app.json --output-type dot > dependency-graph.dot",
    "audit": "npm run audit:knip && npm run audit:deps"
  },
  "dependencies": {
    "madge": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.23",
    "dependency-cruiser": "^18.1.1",
    "globals": "^17.11.0",
    "jscpd": "^5.0.16",
    "knip": "^6.29.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
