{
  "name": "wilderfolk",
  "private": true,
  "version": "0.6.4",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "check:source": "node scripts/check-source-shadow-files.mjs",
    "test": "npm run test:standard",
    "test:standard": "npm run check:source && npm run dup && vitest run --exclude tests/fullYear.integration.test.ts",
    "test:all": "npm run test:standard && npm run test:types && npm run lint",
    "test:full-year:test": "vitest run tests/fullYear.integration.test.ts",
    "test:full": "npm run test:all && npm run test:full-year",
    "test:types": "tsc -p tsconfig.vitest.json --noEmit",
    "test:watch": "vitest",
    "test:full-year": "tsx scripts/run-full-year.mts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:accept": "npm run build && npm run test:browser",
    "lint": "oxlint --type-aware --type-check src scripts vite.config.ts vitest.config.ts",
    "lint:fix": "oxlint --type-aware --type-check --fix src scripts vite.config.ts vitest.config.ts",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:dev:log": "node scripts/run-tauri-dev-log.mjs",
    "tauri:build": "tauri build",
    "dup": "jscpd src --min-lines 6 --min-tokens 60 --format typescript,tsx,javascript --ignore \"**/test/**,**/*.test.ts,**/data/**\"",
    "audit:knip": "knip",
    "audit:deps": "node scripts/check-import-cycles.mjs",
    "audit:deps:cycles": "node scripts/check-import-cycles.mjs",
    "audit:deps:cycles:strict": "node scripts/check-import-cycles.mjs --strict",
    "audit:deps:graph": "node scripts/check-import-cycles.mjs --json",
    "graph:calls": "node scripts/build-call-graph.mjs",
    "audit": "npm run audit:knip && npm run audit:deps"
  },
  "packageManager": "",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "pixi.js": "^8.20.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.3.1",
    "jscpd": "^5.2.1",
    "knip": "^6.36.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "ts-call-graph": "^0.1.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
